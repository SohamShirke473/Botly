# Clerk Authentication Keys
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Express Server Configuration
PORT=3001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database (Postgres)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/botly_db

# Inngest (background jobs)
# Local dev: no keys needed — Inngest Dev Server runs in-memory
# Production: get keys from https://app.inngest.com
INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_SIGNING_KEY=your_inngest_signing_key
# Set to "1" for local dev to connect to Inngest Dev Server instead of Cloud
INNGEST_DEV=1
